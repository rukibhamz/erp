# Application environment (copy to .env and customize; never commit .env)
# Existing deployments: secrets are auto-migrated from config.php on first request after pull.
APP_INSTALLED=true
APP_ENV=development
APP_BASE_URL=http://localhost/newerp/

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=erp
DB_PREFIX=erp_

# Application encryption key (generate: php -r "echo bin2hex(random_bytes(32));")
APP_ENCRYPTION_KEY=

# Cron secret for booking payment reminders (?key=...) — required for non-CLI calls
# BOOKING_REMIND_SECRET=

# Shared secret for unattended cron endpoints (e.g. /cron/financial-reconcile?key=...)
# Generate: php -r "echo bin2hex(random_bytes(32));"
# CRON_SECRET=

# Optional email for financial reconcile reports (mismatches/repairs/errors)
# CRON_REPORT_EMAIL=admin@example.com

# Optional batch caps for financial reconcile cron
# CRON_FINANCIAL_BOOKING_LIMIT=2000
# CRON_GATEWAY_LIMIT=200

# Optional verbose booking-wizard debug log (never logs by default)
# BOOKING_WIZARD_DEBUG=0

# Optional: dedicated MySQL user for backup restore (recommended in production)
# DB_RESTORE_USER=erp_restore
# DB_RESTORE_PASSWORD=
